
# ============================================================
# Sprint 17 - MLOps Project
# Git Ignore Configuration
# ============================================================

# ------------------------------------------------------------
# 1. Python cache and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ------------------------------------------------------------
# 2. Virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# 3. Jupyter Notebook temporary files
# ------------------------------------------------------------
.ipynb_checkpoints/
.profile_default/

# ------------------------------------------------------------
# 4. IDE and editor settings
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------------------------
# 5. Operating system files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# 6. Environment variables and secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*accessKeys*.csv
*credentials*.csv

# ------------------------------------------------------------
# 7. Datasets
# Raw data is managed by DVC.
# Processed and drift datasets are generated by the pipeline.
# ------------------------------------------------------------
/data/raw/
/data/processed/
/data/drift/

# DVC pointer files outside these directories remain trackable.
# Example: data/raw.dvc

# ------------------------------------------------------------
# 8. Trained models and artifacts
# ------------------------------------------------------------

# Generated training outputs
/models/runs/
/models/training/
/models/preprocessors/

# Legacy root-level model artifacts
/models/best_model_pipeline.joblib
/models/best_model_metadata.json

# DVC-managed reference model binaries
/models/reference/

# Other serialized model formats
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# Keep models/reference.dvc trackable.
# It is outside the ignored models/reference/ directory.

# ------------------------------------------------------------
# 9. MLflow tracking artifacts
# ------------------------------------------------------------
/mlruns/
/mlartifacts/
/mlflow.db
/mlflow.db-*
*.db-journal

# ------------------------------------------------------------
# 10. Generated reports and figures
# ------------------------------------------------------------
/reports/figures/
/reports/drift/
/reports/robustness/

# The final technical report remains trackable:
# reports/Sprint_17_Final_Technical_Report.pdf

# ------------------------------------------------------------
# 11. Testing and coverage artifacts
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# 12. Logs and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak

# ------------------------------------------------------------
# 13. DVC local cache and configuration
# ------------------------------------------------------------
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local
